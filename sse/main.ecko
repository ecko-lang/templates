# The entry point: bind a port and serve. Run it from this directory, because
# the static route resolves `static/` against the working directory.
#
#   ecko dev main.ecko    then open http://localhost:8080

import std.http
import std.os
import "./app.ecko"

port = int(os.env_or("PORT", "8080"))

# 127.0.0.1 by default, so a laptop on a shared network is not serving the
# whole network. `http.serve` binds 0.0.0.0 when you do not say otherwise, so
# a container or a VM wants HOST=0.0.0.0.
host = os.env_or("HOST", "127.0.0.1")

print("listening on http://{host}:{port}")
http.serve(port, app.routes(), host: host)
