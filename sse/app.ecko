# The stream and its handlers, kept apart from the code that binds the port.
# A streaming response is a map with a `stream:` channel; the server writes
# each value it receives as a chunk and ends the body when the channel closes.

import std.http
import std.web

## frame(data) -> one server-sent-events frame, terminator included.
export fn frame(data) = "data: " + data + "\n\n"

## feed(ch, count, delay) -> sends `count` frames to `ch`, then closes it.
## `delay` is in milliseconds, like every duration in Ecko (`sleep` too).
## Called rather than awaited: an async fn spawns a task on call, so the
## handler returns its response immediately and the body fills in behind it.
export async fn feed(ch, count, delay) {
    for i in range(1, count + 1) {
        send(ch, frame("tick {i}"))
        if delay > 0 { sleep(delay) }
    }
    send(ch, frame("done"))
    close(ch)
}

## events(req) -> an SSE response whose body streams five ticks, one a second.
export fn events(_req) {
    ch = channel()
    feed(ch, 5, 1000)
    {
        status: 200,
        headers: { "content-type": "text/event-stream", "cache-control": "no-cache" },
        stream: ch,
    }
}

## home(req) -> the browser client that subscribes to /events.
## Read per request, so editing the page needs no restart. `std.web` has no
## directory index, which is why `/` is a route rather than a static mount.
export fn home(_req) = http.html(read_file("static/index.html"))

## routes() -> the dispatcher passed to http.serve.
export fn routes() = web.router(
    [web.get("/", home), web.get("/events", events), web.static("/static", "static")],
)
